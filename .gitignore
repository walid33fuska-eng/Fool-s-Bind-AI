# Fool's Bind AI - .gitignore
# يحمي الملفات الحساسة من الرفع إلى GitHub

# ============================================
# 🔑 ملفات المفاتيح والبيانات الحساسة
# ============================================
.env
*.key
*.pem
*.crt
*.secret
groq_api_key.txt
api_key.txt
config/api.key
config/ios_path.conf
config/secret.key

# ============================================
# 📁 سجلات التشغيل (Logs)
# ============================================
logs/
*.log
logs/doctor.log
logs/nurses/*.log
logs/guards/*.log
logs/director/*.log

# ============================================
# 🧪 ملفات مؤقتة ونسخ احتياطية
# ============================================
*.tmp
*.bak
*.swp
*.swo
*~
*.old
*.orig
backup/
*.backup

# ============================================
# 🛡️ ملفات QFEM والتحقق من السلامة
# ============================================
config/integrity.sha256
config/hashes.db
qfem_state.dat

# ============================================
# 🧬 ملفات خاصة بالأدوات الإجرامية (لا تُرفع)
# ============================================
blacklist_custom.db
safety_override.conf

# ============================================
# 📱 ملفات خاصة بالمنصات
# ============================================
ios_path.conf
android_debug.txt

# ============================================
# 💻 ملفات التطوير (IDE)
# ============================================
.idea/
.vscode/
*.sublime-*
.DS_Store
Thumbs.db

# ============================================
# 📦 ملفات الحزم (Packages)
# ============================================
*.tar
*.gz
*.zip
*.rar
vendor/
node_modules/

# ============================================
# 🧹 ملفات Perl العامة
# ============================================
*.o
*.cgi
blib/
Makefile
Makefile.old
pm_to_blib

# ============================================
# 🚫 أي ملف يحتوي على كلمة "secret" أو "private"
# ============================================
*secret*
*private*
*credential*
*password*

# ============================================
# ✅ ملفات المستخدم (لا تُرفع لخصوصية الجهاز)
# ============================================
user_preferences.conf
user_history.db
local_config.pl
