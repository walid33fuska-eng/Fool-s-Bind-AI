هذا الترخيص يمنحك حق استخدام الأداة فقط، وليس حق النسخ أو التعديل أو التوزيع.

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

⚕️ الاستخدام المسموح به:

1. استخدام الأداة لإصلاح الأدوات المعطوبة في بيئة Termux (Android و iOS)
2. الاستخدام الشخصي غير التجاري فقط
3. تشغيل الأداة كما هي دون أي تعديل

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

⛔ الاستخدام الممنوع:

1. نسخ الأداة أو نقلها إلى جهاز آخر
2. تفكيك الأداة أو هندستها العكسية (Reverse Engineering)
3. تعديل أي ملف من ملفات الأداة
4. إزالة أو تغيير أي من بنود هذا الترخيص
5. تشغيل أو إصلاح أي أداة مصنفة كـ "إجرامية" في قاعدة بيانات الأداة
6. استخدام الأداة لأغراض غير قانونية أو غير أخلاقية
7. بيع الأداة أو أي جزء منها
8. استخدام الأداة في تطبيقات تجارية

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

⚠️ الإقرارات:

1. أنا (المستخدم) أقر بأنني قرأت وفهمت بنود هذا الترخيص
2. أنا أتحمل المسؤولية الكاملة عن أي استخدام للأداة
3. أنا أوافق على أن الأداة قد تقوم بتدمير نفسها إذا تم اكتشاف أي انتهاك لهذا الترخيص
4. أنا أعلم أن محاولة تفكيك الأداة تؤدي إلى تدميرها تلقائياً

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

⚖️ العقوبات عند المخالفة:

المخالفة          │ العقوبة
─────────────────┼────────────────────────────────────────────────
تعديل ملف واحد   │ تدمير الأداة لنفسها تلقائياً
نسخ الأداة       │ تدمير النسخة المنسوخة + تسجيل المخالف
تفكيك الأداة     │ تدمير الأداة بالكامل + منع دائم
تشغيل أداة إجرامية│ رفض التعامل + تسجيل المحاولة
محاولة ثانية     │ إغلاق الأداة + قائمة سوداء محلية
محاولة ثالثة     │ منع دائم + إبلاغ الخادم المركزي (في الإصدارات المستقبلية)

━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

